{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the app's own page may ask the native side to do.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/sudsarkar13" },
        { "url": "https://github.com/sudsarkar13/tourledger" },
        { "url": "https://github.com/sudsarkar13/tourledger/*" },
        { "url": "https://www.sudeeptasarkar.in/" },
        { "url": "https://www.linkedin.com/in/sudeepta-sarkar" }
      ]
    },
    "allow-api",
    "allow-save-file",
    "allow-update-status",
    "allow-update-check",
    "allow-update-download",
    "allow-update-install"
  ]
}
